{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "UrlShortener.Caching.CachedUrlShortenerService": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": { "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}" }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=UrlShortener;User Id=sa;Password=Your_strong_Passw0rd!;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Cache": {
    "TtlMinutes": 10,
    "FailureCooldownSeconds": 30
  },
  "Shortener": {
    "BaseUrl": "http://localhost:8080",
    "DefaultExpiryDays": 30,
    "MaxExpiryDays": 365
  },
  "Analytics": {
    "Salt": "dev-only-change-me",
    "QueueCapacity": 10000,
    "BatchSize": 100,
    "FlushIntervalSeconds": 2,
    "CountryHeader": "CF-IPCountry"
  },
  "RateLimit": {
    "Enabled": false,
    "Write": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Read": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Cleanup": {
    "Enabled": true,
    "IntervalMinutes": 60,
    "GracePeriodDays": 7,
    "BatchSize": 1000
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
